# Base URL of the backend API (without /api/v1; the client adds the prefix).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# O token do Figma MCP NÃO pertence a ficheiros .env* do frontend: os clientes
# MCP nunca os leem (só o Next os carrega). Fonte única = shell:
#   export FIGMA_API_KEY=figd_xxx   (em ~/.zshenv ou ~/.profile)
# Todos os MCP clients (OpenCode, Claude Code, Cursor, DeepCode) herdam esta
# variável do processo pai; nenhuma config precisa de campo `env`.
